---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PersonCard from '../../components/PersonCard.astro';
import type { SocialLink } from '../../components/SocialLinks.astro';
import { site } from '../../data/site';
import { getPeople } from '../../utils/content';
import { publicFileExists } from '../../utils/assets';
import { withBase } from '../../utils/paths';

const people = await getPeople();
const lead = people.find((person) => person.data.lead);
const members = people.filter((person) => !person.data.lead);

/** Long-biography paragraphs come from the Markdown body of the person entry. */
const LeadBio = lead ? (await render(lead)).Content : undefined;

/** The CV button only exists when the PDF has actually been added. */
const cvLinks: SocialLink[] = publicFileExists(site.cvPath)
  ? [{ label: 'CV (PDF)', href: withBase(site.cvPath), icon: 'document' }]
  : [];
---

<BaseLayout
  title="People"
  description={`People at LUMI Lab, ${site.institution}. Led by Prof. ${site.piName}, the lab is growing and welcomes prospective graduate students and undergraduate research interns.`}
>
  <section class="section page-intro">
    <div class="container">
      <div class="page-intro__inner">
        <p class="eyebrow">People</p>
        <h1 class="page-intro__title">
          A new lab, built around careful and collaborative research
        </h1>
      </div>
    </div>
  </section>

  <section class="section section--tight section--surface">
    <div class="container">
      {
        lead && (
          <PersonCard person={lead} extraLinks={cvLinks}>
            {LeadBio && (
              <div class="person__long-bio">
                <LeadBio />
              </div>
            )}
          </PersonCard>
        )
      }
    </div>
  </section>

  {
    members.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="members__heading">Lab members</h2>
          <ul class="members">
            {members.map((member) => (
              <li>
                <PersonCard person={member} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tint">
    <div class="container">
      <div class="growing">
        <h2 class="growing__title">We are growing</h2>
        <p class="growing__body">
          New members will be added here as LUMI grows. We welcome inquiries from
          prospective graduate students and undergraduate research interns who are excited
          about trustworthy AI and careful empirical research.
        </p>
        <p class="growing__action">
          <a class="btn btn--primary" href={withBase('/join/')}>
            Join LUMI
            <Icon name="arrow-right" size={16} />
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__inner {
    max-width: var(--width-prose);
  }

  .page-intro__title {
    margin-top: var(--space-md);
  }

  .members__heading {
    margin-bottom: var(--space-xl);
  }

  .members {
    display: grid;
    gap: var(--space-2xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .growing {
    max-width: var(--width-prose);
  }

  .growing__body {
    margin-top: var(--space-md);
    color: var(--color-muted-strong);
  }

  .growing__action {
    margin-top: var(--space-lg);
  }
</style>

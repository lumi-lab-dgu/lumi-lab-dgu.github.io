---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PersonCard from '../../components/PersonCard.astro';
import PublicationList from '../../components/PublicationList.astro';
import type { SocialLink } from '../../components/SocialLinks.astro';
import { site } from '../../data/site';
import { getPeople, getPublications } from '../../utils/content';
import { publicFileExists } from '../../utils/assets';
import { withBase } from '../../utils/paths';

const people = await getPeople();
const lead = people.find((person) => person.data.lead);
const members = people.filter((person) => !person.data.lead);
const publications = await getPublications();

/** Long-biography paragraphs come from the Markdown body of the person entry. */
const LeadBio = lead ? (await render(lead)).Content : undefined;

/** The CV button only exists when the PDF has actually been added. */
const cvLinks: SocialLink[] = publicFileExists(site.cvPath)
  ? [{ label: 'CV (PDF)', href: withBase(site.cvPath), icon: 'document' }]
  : [];
---

<BaseLayout
  title="People"
  description={`Prof. ${site.piName} leads LUMI Lab in the ${site.department} at ${site.institution}, researching trustworthy language models, LLM evaluation, reliable agents, and multimodal systems.`}
>
  <!-- PI profile. Its name is the page heading, so there is no separate title block. -->
  <section class="section section--tight">
    <div class="container">
      {
        lead && (
          <PersonCard person={lead} extraLinks={cvLinks} headingLevel="h1">
            {LeadBio && (
              <div class="person__long-bio">
                <LeadBio />
              </div>
            )}
          </PersonCard>
        )
      }
    </div>
  </section>

  {
    members.length > 0 && (
      <section class="section section--surface">
        <div class="container">
          <h2 class="section-title">Lab members</h2>
          <ul class="members">
            {members.map((member) => (
              <li>
                <PersonCard person={member} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Publications -->
  <section class="section section--surface">
    <div class="container">
      <h2 class="section-title">Publications</h2>
      <p class="section-note">
        Work produced after the launch of LUMI Lab will be marked separately as LUMI Lab
        research.
      </p>
      <div class="publications-wrapper">
        <PublicationList publications={publications} variant="full" headingLevel="h3" />
        <p class="footnote">* Equal contribution.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="growing">
        <h2 class="growing__title">We are growing</h2>
        <p class="growing__body">
          New members will be added here as LUMI grows. We welcome inquiries from
          prospective graduate students and undergraduate research interns who are excited
          about trustworthy AI and careful empirical research.
        </p>
        <p class="growing__action">
          <a class="btn btn--primary" href={withBase('/join/')}>
            Join LUMI
            <Icon name="arrow-right" size={16} />
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-title {
    font-size: var(--text-h2);
  }

  .section-note {
    margin-top: var(--space-xs);
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .members {
    display: grid;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .publications-wrapper {
    margin-top: var(--space-lg);
  }

  .footnote {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .growing {
    max-width: var(--width-prose);
  }

  .growing__body {
    margin-top: var(--space-md);
    color: var(--color-muted-strong);
  }

  .growing__action {
    margin-top: var(--space-lg);
  }
</style>

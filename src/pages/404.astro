---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../data/i18n';
import { withBase } from '../utils/paths';

/**
 * GitHub Pages serves one 404 for the whole site, including /ko/ paths, so this
 * page carries both languages rather than picking one.
 */
const en = ui.en.notFound;
const ko = ui.ko.notFound;
---

<BaseLayout
  title="Page not found"
  description={en.metaDescription}
  lang="en"
  path="/404.html"
>
  <section class="section not-found">
    <div class="container">
      <div class="not-found__inner">
        <p class="eyebrow">404</p>
        <h1 class="not-found__title">{en.title}</h1>
        <p class="lead not-found__body">{en.body}</p>
        <p class="not-found__body-ko" lang="ko">{ko.body}</p>
        <div class="button-row not-found__actions">
          <a class="btn btn--primary" href={withBase('/')}>
            {en.cta}
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn--secondary" href={withBase('/ko/')} lang="ko">{ko.cta}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
  }

  .not-found__inner {
    max-width: var(--width-prose);
  }

  .not-found__title {
    margin-top: var(--space-md);
  }

  .not-found__body {
    margin-top: var(--space-lg);
  }

  .not-found__body-ko {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    word-break: keep-all;
  }

  .not-found__actions {
    margin-top: var(--space-xl);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { links, site } from '../../data/site';

const opportunities = [
  {
    title: 'Graduate students',
    text: 'Prospective graduate students who want to work on trustworthy LLMs, agent reliability, evaluation, or multimodal systems are encouraged to introduce their interests and prior experience.',
  },
  {
    title: 'Undergraduate research interns',
    text: 'Undergraduate students can inquire about research internships. Prior research is helpful but not required; evidence of initiative, solid programming foundations, and willingness to read and test ideas carefully is especially valuable.',
  },
  {
    title: 'Collaboration and projects',
    text: 'We welcome research collaboration, project participation, and proposal discussions with academic and industry partners whose goals align with the lab’s research.',
  },
];

const emailChecklist = [
  'a short introduction',
  'the opportunity you are asking about',
  'research interests and why they connect to LUMI',
  'CV',
  'expected start date and period',
  'links to relevant papers, projects, GitHub repositories, or code samples, when available',
];

const faq = [
  {
    question: 'Do I need a fully formed research topic?',
    answer:
      'No. A concrete area of interest and evidence that you have explored it are enough for an initial inquiry.',
  },
  {
    question: 'Is prior research required for undergraduate interns?',
    answer:
      'No, but programming fundamentals, initiative, and willingness to read papers carefully are important.',
  },
  {
    question: 'Can I propose a collaboration?',
    answer:
      'Yes. Briefly describe the shared problem, expected contribution, and timeline.',
  },
];
---

<BaseLayout
  title="Join"
  description="LUMI Lab welcomes prospective graduate students, undergraduate research interns, and research collaborators interested in trustworthy language models, reliable agents, multimodal evaluation, and AI safety."
>
  <section class="section page-intro">
    <div class="container">
      <div class="page-intro__inner">
        <p class="eyebrow">Join LUMI</p>
        <h1 class="page-intro__title">
          Build careful, useful, and trustworthy AI research with us
        </h1>
        <p class="lead page-intro__lead">
          We welcome inquiries from prospective graduate students, undergraduate research
          interns, and research collaborators interested in trustworthy language models,
          reliable agents, multimodal evaluation, and AI safety. We value curiosity,
          initiative, careful experimentation, clear communication, and respect for
          collaborators.
        </p>
        <p class="page-intro__action">
          <a class="btn btn--primary" href={links.emailInquiry}>
            <Icon name="mail" size={16} />
            Email Prof. {site.piName}
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Opportunities -->
  <section class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow="Opportunities" title="Who we are looking for" />
      <ul class="opportunities">
        {
          opportunities.map((opportunity) => (
            <li class="opportunity">
              <h3 class="opportunity__title">{opportunity.title}</h3>
              <p class="opportunity__text">{opportunity.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- First email -->
  <section class="section">
    <div class="container">
      <div class="first-email">
        <SectionHeading eyebrow="Getting in touch" title="What to include in your first email" />
        <ul class="checklist">
          {emailChecklist.map((item) => <li class="checklist__item">{item}</li>)}
        </ul>
        <p class="first-email__note">
          A transcript is optional for the first inquiry unless otherwise specified.
        </p>
        <div class="subject-line">
          <p class="subject-line__label">Suggested email subject</p>
          <p class="subject-line__value">
            <code>[LUMI Inquiry] Name — Graduate / Undergraduate Intern / Collaboration</code>
          </p>
        </div>
        <p class="first-email__action">
          <a class="btn btn--primary" href={links.emailInquiry}>
            <Icon name="mail" size={16} />
            Email Prof. {site.piName}
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Korean summary -->
  <section class="section section--tint">
    <div class="container">
      <div class="korean" lang="ko">
        <h2 class="korean__title">함께 연구할 분을 기다립니다</h2>
        <p class="korean__body">
          LUMI Lab은 신뢰할 수 있는 언어모델, LLM 에이전트, 멀티모달 평가, AI 안전성에 관심 있는
          대학원생과 학부 연구인턴의 문의를 환영합니다. 간단한 자기소개, 관심 연구 주제, 지원 형태,
          가능한 시작 시기와 기간, CV 및 관련 프로젝트·코드 링크가 있다면 함께 보내 주세요. 공동 연구,
          과제 참여 및 제안에 관한 연락도 환영합니다.
        </p>
        <p class="korean__email">
          <a href={links.emailInquiry}>{site.email}</a>
        </p>
      </div>
      <p class="disclaimer">
        An inquiry does not constitute an admission or appointment offer. Formal university
        admission requirements and timelines apply separately.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow="FAQ" title="Common questions" />
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq__item">
              <summary class="faq__question">
                <span>{item.question}</span>
                <svg
                  class="faq__chevron"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="faq__answer">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__inner {
    max-width: var(--width-prose);
  }

  .page-intro__title {
    margin-top: var(--space-md);
  }

  .page-intro__lead {
    margin-top: var(--space-lg);
  }

  .page-intro__action {
    margin-top: var(--space-xl);
  }

  /* --- Opportunities --- */

  .opportunities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .opportunity {
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-primary);
  }

  .opportunity__text {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-muted-strong);
  }

  /* --- First email --- */

  .first-email {
    max-width: var(--width-prose);
  }

  .checklist {
    margin-top: var(--space-lg);
    padding-left: 0;
    list-style: none;
  }

  .checklist__item {
    position: relative;
    padding-left: 1.5rem;
    padding-block: 0.3rem;
  }

  .checklist__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.95em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .first-email__note {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .subject-line {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .subject-line__label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .subject-line__value {
    margin-top: var(--space-xs);
    overflow-wrap: break-word;
  }

  .subject-line__value code {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .first-email__action {
    margin-top: var(--space-xl);
  }

  /* --- Korean section --- */

  .korean {
    max-width: var(--width-prose);
  }

  .korean__body {
    margin-top: var(--space-md);
    line-height: 1.8;
    color: var(--color-muted-strong);
  }

  .korean__email {
    margin-top: var(--space-md);
    font-weight: 600;
  }

  .korean__email a {
    display: inline-block;
    padding-block: 0.15rem;
  }

  .disclaimer {
    margin-top: var(--space-xl);
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* --- FAQ --- */

  .faq {
    max-width: var(--width-prose);
    margin-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--color-primary-dark);
  }

  .faq__chevron {
    transition: transform var(--duration) var(--easing);
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__answer {
    padding-bottom: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted-strong);
  }
</style>

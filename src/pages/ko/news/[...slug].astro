---
import type { GetStaticPaths } from 'astro';
import NewsPage from '../../../views/NewsPage.astro';
import { getNews } from '../../../utils/content';

/**
 * The news index builds only when the collection has visible entries, so an
 * empty lab never ships an empty page.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const news = await getNews();
  return news.length > 0 ? [{ params: { slug: undefined } }] : [];
};
---

<NewsPage lang="ko" />

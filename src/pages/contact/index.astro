---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks, { type SocialLink } from '../../components/SocialLinks.astro';
import { links, site } from '../../data/site';

const contactRows = [
  { label: 'Email', value: site.email, href: links.email },
  { label: 'Department', value: site.department, href: links.department },
  { label: 'Institution', value: site.institution },
  { label: 'Address', value: site.address },
];

const contactButtons: SocialLink[] = [
  { label: 'Email', href: links.email, icon: 'mail' },
  { label: 'Department', href: links.department, icon: 'globe' },
  { label: 'Personal Website', href: links.piWebsite, icon: 'globe' },
  { label: 'Google Scholar', href: links.scholar, icon: 'scholar' },
  { label: 'GitHub', href: links.github, icon: 'github' },
];
---

<BaseLayout
  title="Contact"
  description={`Contact LUMI Lab at ${site.institution}. Email Prof. ${site.piName} about prospective-student inquiries, research collaboration, or project discussions.`}
>
  <section class="section page-intro">
    <div class="container">
      <div class="page-intro__inner">
        <p class="eyebrow">Contact</p>
        <h1 class="page-intro__title">Contact</h1>
        <p class="lead page-intro__lead">
          For prospective-student inquiries, research collaboration, or project
          discussions, email Prof. {site.piName}.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight section--surface">
    <div class="container">
      <div class="contact">
        <dl class="contact__rows">
          {
            contactRows.map((row) => (
              <div class="contact__row">
                <dt class="contact__label">{row.label}</dt>
                <dd class="contact__value">
                  {row.href ? <a href={row.href}>{row.value}</a> : row.value}
                </dd>
              </div>
            ))
          }
          <div class="contact__row">
            <dt class="contact__label" lang="ko">주소</dt>
            <dd class="contact__value" lang="ko">{site.addressKo}</dd>
          </div>
        </dl>

        <div class="contact__links">
          <h2 class="contact__links-heading">Links</h2>
          <SocialLinks links={contactButtons} label="Contact and profile links" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__inner {
    max-width: var(--width-prose);
  }

  .page-intro__title {
    margin-top: var(--space-md);
  }

  .page-intro__lead {
    margin-top: var(--space-lg);
  }

  .contact {
    max-width: var(--width-prose);
  }

  .contact__rows {
    margin: 0;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .contact__label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
  }

  .contact__value {
    margin: 0;
    overflow-wrap: break-word;
  }

  /* Vertical padding on an inline link grows the touch target without
     affecting the line box, so the layout is unchanged. */
  .contact__value a {
    padding-block: 0.25rem;
  }

  .contact__links {
    margin-top: var(--space-2xl);
  }

  .contact__links-heading {
    margin-bottom: var(--space-md);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 36rem) {
    .contact__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }
  }
</style>

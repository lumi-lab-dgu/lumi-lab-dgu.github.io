---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';
import Icon from '../components/Icon.astro';
import JoinCallout from '../components/JoinCallout.astro';
import NewsList from '../components/NewsList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationList from '../components/PublicationList.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { getFeaturedProjects, getNews, getPublications } from '../utils/content';
import { withBase } from '../utils/paths';

const projects = await getFeaturedProjects();
const homePublications = (await getPublications())
  .filter(({ data }) => data.showOnHome)
  .slice(0, 4);
const news = (await getNews()).slice(0, 4);

const researchHref = withBase('/research/');

function projectHref(anchor: string | undefined, id: string): string {
  return `${researchHref}#${anchor ?? id}`;
}

const heroLead =
  'We research natural language processing, large language models, and trustworthy ' +
  `AI—including LLM evaluation, reliable agents, multimodal systems, and AI safety—under Prof. ${site.piName} at ${site.institution}.`;
---

<BaseLayout
  title="Home"
  description={site.defaultDescription}
  isHome
>
  <!-- Hero -->
  <section class="section hero">
    <div class="container container--wide hero__inner">
      <div class="hero__content">
        <p class="eyebrow">{site.labName} · {site.institution}</p>
        <h1 class="hero__title">{site.labFullName}</h1>
        <p class="lead hero__lead">{heroLead}</p>
        <div class="button-row hero__actions">
          <a class="btn btn--primary" href={researchHref}>
            Explore our research
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn--secondary" href={withBase('/join/')}>Join LUMI</a>
        </div>
        <p class="hero__recruiting">
          We are growing. Graduate students, undergraduate research interns, and research
          collaborators are welcome to get in touch.
        </p>
      </div>

      <div class="hero__visual">
        <HeroVisual />
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="section section--tight mission">
    <div class="container">
      <div class="mission__inner">
        <h2 class="mission__title">Researching reliability where it matters most</h2>
        <p class="mission__body">
          LUMI—{site.labExpansion}—is a research lab in the {site.department} at {
            site.institution
          }, led by Prof. {site.piName}. Our work sits at the intersection of natural
          language processing, trustworthy AI, agentic systems, and multimodal evaluation.
          We investigate where advanced AI systems fail under realistic pressure and build
          benchmarks, analyses, and methods that help make their behavior more reliable.
        </p>
      </div>
    </div>
  </section>

  <!-- Ongoing projects -->
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        eyebrow="Ongoing Projects"
        title="Questions we are working on now"
        description="Our current projects examine failures that emerge when AI systems must evaluate, choose, prioritize, or revise—not just generate an answer once."
      />

      <ul class="project-grid">
        {
          projects.map((project) => (
            <li>
              <ProjectCard project={project} href={projectHref(project.data.anchor, project.id)} />
            </li>
          ))
        }
      </ul>

      <p class="section-footer-link">
        <a class="arrow-link" href={researchHref}>
          Explore all research
          <Icon name="arrow-right" size={16} class="arrow-link__icon" />
        </a>
      </p>
    </div>
  </section>

  <!-- Research focus -->
  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Research Areas"
        title="From evaluation to reliable action"
        description="We study intelligence not only through what models know, but through how they judge, follow priorities, interact with tools, and respond when their first attempt is wrong."
      />
      <div class="research-areas-wrapper">
        <ResearchAreas />
      </div>
    </div>
  </section>

  <!-- Selected work by the PI -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Publications"
        title="Selected Work by the PI"
        description="Selected research that informs the questions we are pursuing at LUMI."
      />
      <div class="home-publications">
        <PublicationList publications={homePublications} variant="compact" />
        <p class="section-footer-link">
          <a class="arrow-link" href={withBase('/publications/')}>
            View all publications
            <Icon name="arrow-right" size={16} class="arrow-link__icon" />
          </a>
        </p>
      </div>
    </div>
  </section>

  {
    /*
      News renders only once the collection has a visible entry. Until then the
      site shows no empty state, no "coming soon" and no navigation item.
    */
    news.length > 0 && (
      <section class="section section--surface">
        <div class="container">
          <SectionHeading eyebrow="News" title="Latest from the lab" />
          <div class="home-news">
            <NewsList news={news} />
            <p class="section-footer-link">
              <a class="arrow-link" href={withBase('/news/')}>
                All news
                <Icon name="arrow-right" size={16} class="arrow-link__icon" />
              </a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <JoinCallout />
</BaseLayout>

<style>
  /* --- Hero --- */

  .hero {
    padding-block: clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }

  .hero__title {
    margin-top: var(--space-md);
    font-size: clamp(2.125rem, 1.55rem + 2.5vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
    max-width: 24ch;
  }

  .hero__lead {
    margin-top: var(--space-lg);
    max-width: 56ch;
  }

  .hero__actions {
    margin-top: var(--space-xl);
  }

  .hero__recruiting {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    max-width: 56ch;
    font-size: var(--text-sm);
    color: var(--color-muted-strong);
  }

  @media (max-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__title {
      max-width: 22ch;
    }

    .hero__visual {
      max-width: 30rem;
    }
  }

  /* --- Mission --- */

  .mission__inner {
    max-width: var(--width-prose);
    padding-left: clamp(0.9rem, 0.5rem + 1vw, 1.5rem);
    border-left: 2px solid var(--color-accent);
  }

  .mission__body {
    margin-top: var(--space-md);
  }

  /* --- Shared section pieces --- */

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .research-areas-wrapper,
  .home-publications,
  .home-news {
    margin-top: var(--space-xl);
  }

  .section-footer-link {
    margin-top: var(--space-lg);
  }
</style>

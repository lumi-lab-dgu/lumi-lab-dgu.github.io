---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PersonCard from '../components/PersonCard.astro';
import PublicationList from '../components/PublicationList.astro';
import type { SocialLink } from '../components/SocialLinks.astro';
import { localeHref, ui, type Locale } from '../data/i18n';
import { site } from '../data/site';
import { getPeople, getPublications } from '../utils/content';
import { publicFileExists } from '../utils/assets';
import { withBase } from '../utils/paths';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];

const people = await getPeople();
const lead = people.find((person) => person.data.lead);
const members = people.filter((person) => !person.data.lead);
const publications = await getPublications();

/** English long biography comes from the Markdown body of the person entry. */
const LeadBio = lead && lang === 'en' ? (await render(lead)).Content : undefined;

/** The CV button only exists when the PDF has actually been added. */
const cvLinks: SocialLink[] = publicFileExists(site.cvPath)
  ? [{ label: t.people.cv, href: withBase(site.cvPath), icon: 'document' }]
  : [];
---

<BaseLayout
  title={t.nav.people}
  description={t.people.metaDescription}
  lang={lang}
  path="/people/"
>
  <!-- PI profile. Its name is the page heading, so there is no separate title block. -->
  <section class="section section--tight">
    <div class="container">
      {
        lead && (
          <PersonCard person={lead} lang={lang} extraLinks={cvLinks} headingLevel="h1">
            {LeadBio && (
              <div class="person__long-bio">
                <LeadBio />
              </div>
            )}
          </PersonCard>
        )
      }
    </div>
  </section>

  {
    members.length > 0 && (
      <section class="section section--surface">
        <div class="container">
          <h2 class="section-title">{t.people.labMembers}</h2>
          <ul class="members">
            {members.map((member) => (
              <li>
                <PersonCard person={member} lang={lang} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tint">
    <div class="container">
      <div class="growing">
        <h2 class="growing__title">{t.people.growingTitle}</h2>
        <p class="growing__body">{t.people.growingBody}</p>
        <p class="growing__action">
          <a class="btn btn--primary" href={withBase(localeHref(lang, '/join/'))}>
            {t.people.joinLumi}
            <Icon name="arrow-right" size={16} />
          </a>
        </p>
      </div>
    </div>
  </section>

  <!--
    Publications: metadata stays in English in both versions. Collapsed by
    default so the profile is not buried under the list; the full list is one
    click away and needs no JavaScript.
  -->
  <section class="section section--tight section--surface">
    <div class="container">
      <details class="pubs">
        <summary class="pubs__summary">
          <h2 class="pubs__heading">{t.people.publicationsHeading}</h2>
          <span class="pubs__action">
            <span class="pubs__action-show">{t.people.publicationsShow}</span>
            <span class="pubs__action-hide">{t.people.publicationsHide}</span>
            <svg
              class="pubs__chevron"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </summary>

        <div class="pubs__body">
          <p class="section-note">{t.people.publicationsNote}</p>
          <PublicationList
            publications={publications}
            variant="full"
            headingLevel="h3"
            lang={lang}
          />
          <p class="footnote">{t.publications.equalContribution}</p>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .section-title {
    font-size: var(--text-h2);
  }

  .section-note {
    margin-top: var(--space-xs);
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    color: var(--color-muted);
    word-break: keep-all;
  }

  .members {
    display: grid;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  /* --- Publications disclosure --- */

  .pubs__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
    list-style: none;
  }

  .pubs__summary::-webkit-details-marker {
    display: none;
  }

  .pubs__heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: var(--text-h2);
  }

  .pubs__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
  }

  .pubs__summary:hover .pubs__action {
    color: var(--color-primary-dark);
  }

  /* Only one of the two labels applies at a time. */
  .pubs__action-hide,
  .pubs[open] .pubs__action-show {
    display: none;
  }

  .pubs[open] .pubs__action-hide {
    display: inline;
  }

  .pubs__chevron {
    transition: transform var(--duration) var(--easing);
  }

  .pubs[open] .pubs__chevron {
    transform: rotate(180deg);
  }

  .pubs__body {
    margin-top: var(--space-lg);
  }

  .pubs__body .section-note {
    margin-bottom: var(--space-xl);
  }

  .footnote {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .growing {
    max-width: var(--width-prose);
  }

  .growing__body {
    margin-top: var(--space-md);
    color: var(--color-muted-strong);
    word-break: keep-all;
  }

  .growing__action {
    margin-top: var(--space-lg);
  }
</style>

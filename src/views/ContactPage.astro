---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks, { type SocialLink } from '../components/SocialLinks.astro';
import { ui, type Locale } from '../data/i18n';
import { links, site } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const isKo = lang === 'ko';

const contactRows = isKo
  ? [
      { label: t.contact.labelEmail, value: site.email, href: links.email },
      { label: t.contact.labelDepartment, value: site.departmentKo, href: links.department },
      { label: t.contact.labelInstitution, value: site.institutionKo },
      { label: t.contact.labelAddressKo, value: site.addressKo },
      { label: t.contact.labelAddress, value: site.address, lang: 'en' },
    ]
  : [
      { label: t.contact.labelEmail, value: site.email, href: links.email },
      { label: t.contact.labelDepartment, value: site.department, href: links.department },
      { label: t.contact.labelInstitution, value: site.institution },
      { label: t.contact.labelAddress, value: site.address },
      { label: t.contact.labelAddressKo, value: site.addressKo, lang: 'ko' },
    ];

const contactButtons: SocialLink[] = [
  { label: t.contact.labelEmail, href: links.email, icon: 'mail' },
  { label: t.contact.labelDepartment, href: links.department, icon: 'globe' },
  { label: t.contact.personalWebsite, href: links.piWebsite, icon: 'globe' },
  { label: 'Google Scholar', href: links.scholar, icon: 'scholar' },
  { label: 'GitHub', href: links.github, icon: 'github' },
];
---

<BaseLayout
  title={t.nav.contact}
  description={t.contact.metaDescription}
  lang={lang}
  path="/contact/"
>
  <section class="section page-intro">
    <div class="container">
      <div class="page-intro__inner">
        <p class="eyebrow">{t.contact.kicker}</p>
        <h1 class="page-intro__title">{t.contact.title}</h1>
        <p class="lead page-intro__lead">{t.contact.lead}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight section--surface">
    <div class="container">
      <div class="contact">
        <dl class="contact__rows">
          {
            contactRows.map((row) => (
              <div class="contact__row">
                <dt class="contact__label">{row.label}</dt>
                <dd class="contact__value" lang={row.lang}>
                  {row.href ? <a href={row.href}>{row.value}</a> : row.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="contact__links">
          <h2 class="contact__links-heading">{t.contact.linksHeading}</h2>
          <SocialLinks links={contactButtons} label={t.contact.linksNav} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__inner {
    max-width: var(--width-prose);
  }

  .page-intro__title {
    margin-top: var(--space-md);
  }

  .page-intro__lead {
    margin-top: var(--space-lg);
    word-break: keep-all;
  }

  .contact {
    max-width: var(--width-prose);
  }

  .contact__rows {
    margin: 0;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .contact__label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
  }

  .contact__value {
    margin: 0;
    overflow-wrap: break-word;
  }

  /* Vertical padding on an inline link grows the touch target without
     affecting the line box, so the layout is unchanged. */
  .contact__value a {
    padding-block: 0.25rem;
  }

  .contact__links {
    margin-top: var(--space-2xl);
  }

  .contact__links-heading {
    margin-bottom: var(--space-md);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 36rem) {
    .contact__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }
  }
</style>

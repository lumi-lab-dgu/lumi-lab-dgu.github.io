---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import { ui, type Locale } from '../data/i18n';
import { getNews } from '../utils/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const news = await getNews();
---

<BaseLayout
  title={t.nav.news}
  description={t.home.metaDescription}
  lang={lang}
  path="/news/"
>
  <section class="section page-intro">
    <div class="container">
      <div class="page-intro__inner">
        <p class="eyebrow">{t.home.newsEyebrow}</p>
        <h1 class="page-intro__title">{t.nav.news}</h1>
      </div>
    </div>
  </section>

  <section class="section section--tight section--surface">
    <div class="container">
      <div class="news-wrapper">
        <NewsList news={news} headingLevel="h2" lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__inner {
    max-width: var(--width-prose);
  }

  .page-intro__title {
    margin-top: var(--space-md);
  }

  .news-wrapper {
    max-width: var(--width-prose);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { ui, type Locale } from '../data/i18n';
import { links, site } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<BaseLayout title={t.nav.join} description={t.join.metaDescription} lang={lang} path="/join/">
  <section class="section page-intro">
    <div class="container">
      <div class="page-intro__inner">
        <p class="eyebrow">{t.join.kicker}</p>
        <h1 class="page-intro__title">{t.join.title}</h1>
        <p class="lead page-intro__lead">{t.join.intro}</p>
        <p class="page-intro__action">
          <a
            class="btn btn--primary"
            href={links.emailInquiry}
            aria-label={`${t.common.emailAria}: ${site.email}`}
          >
            <Icon name="mail" size={16} />
            {site.email}
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Opportunities -->
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        eyebrow={t.join.opportunitiesEyebrow}
        title={t.join.opportunitiesTitle}
      />
      <ul class="opportunities">
        {
          t.join.opportunities.map((opportunity) => (
            <li class="opportunity">
              <h3 class="opportunity__title">{opportunity.title}</h3>
              <p class="opportunity__text">{opportunity.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- First email -->
  <section class="section">
    <div class="container">
      <div class="first-email">
        <SectionHeading
          eyebrow={t.join.emailEyebrow}
          title={t.join.emailTitle}
          description={t.join.emailIntro}
        />
        <ul class="checklist">
          {t.join.checklist.map((item) => <li class="checklist__item">{item}</li>)}
        </ul>
        <p class="first-email__note">{t.join.transcriptNote}</p>
        <p class="first-email__action">
          <a
            class="btn btn--primary"
            href={links.emailInquiry}
            aria-label={`${t.common.emailAria}: ${site.email}`}
          >
            <Icon name="mail" size={16} />
            {site.email}
          </a>
        </p>
        <p class="disclaimer">{t.join.disclaimer}</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow={t.join.faqEyebrow} title={t.join.faqTitle} />
      <div class="faq">
        {
          t.join.faq.map((item) => (
            <details class="faq__item">
              <summary class="faq__question">
                <span>{item.question}</span>
                <svg
                  class="faq__chevron"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="faq__answer">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__inner {
    max-width: var(--width-prose);
  }

  .page-intro__title {
    margin-top: var(--space-md);
    word-break: keep-all;
  }

  .page-intro__lead {
    margin-top: var(--space-lg);
    word-break: keep-all;
  }

  .page-intro__action {
    margin-top: var(--space-xl);
  }

  /* --- Opportunities --- */

  .opportunities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .opportunity {
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-primary);
  }

  .opportunity__title {
    word-break: keep-all;
  }

  .opportunity__text {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-muted-strong);
    word-break: keep-all;
  }

  /* --- First email --- */

  .first-email {
    max-width: var(--width-prose);
  }

  .checklist {
    margin-top: var(--space-lg);
    padding-left: 0;
    list-style: none;
  }

  .checklist__item {
    position: relative;
    padding-left: 1.5rem;
    padding-block: 0.3rem;
    word-break: keep-all;
  }

  .checklist__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.95em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .first-email__note {
    margin-top: var(--space-md);
    /* Narrower than the prose column: at 15px the full width runs to ~96
       characters a line, which is past comfortable reading. */
    max-width: 64ch;
    font-size: var(--text-sm);
    color: var(--color-muted);
    word-break: keep-all;
  }

  .first-email__action {
    margin-top: var(--space-xl);
  }

  .disclaimer {
    margin-top: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--color-muted);
    word-break: keep-all;
  }

  /* --- FAQ --- */

  .faq {
    max-width: var(--width-prose);
    margin-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    word-break: keep-all;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--color-primary-dark);
  }

  .faq__chevron {
    flex: none;
    transition: transform var(--duration) var(--easing);
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__answer {
    padding-bottom: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted-strong);
    word-break: keep-all;
  }
</style>

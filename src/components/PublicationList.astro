---
import Icon from './Icon.astro';
import { defaultLocale, type Locale } from '../data/i18n';
import { site } from '../data/site';
import { groupPublicationsByYear, type PublicationEntry } from '../utils/content';

interface Props {
  publications: PublicationEntry[];
  /**
   * `full`    — grouped under year headings, with descriptions and links.
   * `compact` — a flat editorial list for the home page.
   */
  variant?: 'full' | 'compact';
  /**
   * Heading level for the year headings. Paper titles sit one level below, so
   * the list nests correctly under whatever section contains it.
   */
  headingLevel?: 'h2' | 'h3';
  lang?: Locale;
}

const { publications, variant = 'full', headingLevel = 'h2', lang = defaultLocale } = Astro.props;

const YearHeading = headingLevel;
const TitleHeading = headingLevel === 'h2' ? 'h3' : 'h4';

const groups =
  variant === 'full'
    ? groupPublicationsByYear(publications)
    : [{ year: 0, items: publications }];

/**
 * Era labels only earn their space once the list actually mixes LUMI work with
 * earlier work. Until then the page intro carries that context instead.
 */
const eras = new Set(publications.map((publication) => publication.data.labEra));
const showEraLabels = eras.size > 1;

function actionsFor(publication: PublicationEntry) {
  const { paperUrl, pdfUrl, codeUrl, projectUrl } = publication.data;
  return [
    { label: 'Paper', href: paperUrl },
    { label: 'PDF', href: pdfUrl },
    { label: 'Code', href: codeUrl },
    { label: 'Project', href: projectUrl },
  ].filter((action): action is { label: string; href: string } => Boolean(action.href));
}
---

<div class:list={['publications', `publications--${variant}`]} lang="en">
  {
    groups.map((group) => (
      <section class="publications__group">
        {variant === 'full' && (
          <YearHeading class="publications__year" id={`year-${group.year}`}>
            {group.year}
          </YearHeading>
        )}

        <ol class="publications__list">
          {group.items.map((publication) => {
            const actions = actionsFor(publication);
            return (
              <li class="publication">
                <TitleHeading class="publication__title">
                  {publication.data.paperUrl ? (
                    <a class="publication__title-link" href={publication.data.paperUrl}>
                      {publication.data.title}
                    </a>
                  ) : (
                    publication.data.title
                  )}
                </TitleHeading>

                <p class="publication__authors">
                  {publication.data.authors.map((author, index) => (
                    <>
                      {index > 0 && <span aria-hidden="true">, </span>}
                      {author.startsWith(site.piName) ? (
                        <strong class="publication__pi">{author}</strong>
                      ) : (
                        <span>{author}</span>
                      )}
                    </>
                  ))}
                </p>

                <p class="publication__meta">
                  <span class="publication__venue">{publication.data.venue}</span>
                  {/* The compact list has no year headings, so the year is
                      appended here — unless the venue already carries it. */}
                  {variant === 'compact' &&
                    !publication.data.venue.includes(String(publication.data.year)) && (
                      <span class="publication__year-inline"> · {publication.data.year}</span>
                    )}
                  {showEraLabels && (
                    <span class="publication__era">
                      {publication.data.labEra === 'lumi'
                        ? 'LUMI Lab'
                        : lang === 'ko'
                          ? 'LUMI 이전'
                          : 'Prior to LUMI'}
                    </span>
                  )}
                </p>

                {variant === 'full' && publication.data.description && (
                  <p class="publication__description">{publication.data.description}</p>
                )}

                {actions.length > 0 && (
                  <ul class="publication__actions">
                    {actions.map((action) => (
                      <li>
                        <a class="publication__action" href={action.href}>
                          {action.label}
                          <Icon name="arrow-up-right" size={14} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .publications__group + .publications__group {
    margin-top: var(--space-2xl);
  }

  .publications__year {
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-primary-dark);
    scroll-margin-top: calc(var(--header-height) + var(--space-lg));
  }

  .publications__list {
    list-style: none;
    margin: 0;
  }

  .publication {
    padding-block: var(--space-lg);
  }

  .publications--full .publication + .publication {
    border-top: 1px solid var(--color-border);
  }

  .publications--compact .publication {
    padding-block: var(--space-md);
  }

  .publications--compact .publication + .publication {
    border-top: 1px solid var(--color-border);
  }

  .publication__title {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .publication__title-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .publication__title-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .publication__authors {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-muted-strong);
    overflow-wrap: break-word;
  }

  .publication__pi {
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .publication__meta {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
  }

  .publication__venue {
    font-weight: 600;
    color: var(--color-text);
  }

  .publication__year-inline {
    color: var(--color-muted);
  }

  .publication__era {
    display: inline-block;
    margin-left: var(--space-xs);
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
  }

  .publication__description {
    margin-top: var(--space-xs);
    max-width: 68ch;
    font-size: var(--text-sm);
    color: var(--color-muted-strong);
  }

  .publication__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .publication__action {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .publication__action:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }
</style>

---
import { localeCode, localeHref, localeLabel, locales, ui, type Locale } from '../data/i18n';
import { withBase } from '../utils/paths';

/**
 * Both languages are always visible, with the active one filled in, so the
 * reader can see which version they are on and what the alternative is —
 * a single toggle showed only the destination and left the current state
 * to be inferred.
 */

interface Props {
  lang: Locale;
  /** Locale-less path of the current page, e.g. "/research/". */
  path: string;
}

const { lang, path } = Astro.props;
const t = ui[lang];
---

<nav class="lang-switch" aria-label={t.common.languageLabel}>
  {
    locales.map((locale) => {
      const current = locale === lang;
      return (
        <a
          class:list={['lang-switch__option', { 'lang-switch__option--current': current }]}
          href={withBase(localeHref(locale, path))}
          hreflang={locale}
          lang={locale}
          aria-current={current ? 'true' : undefined}
          aria-label={localeLabel[locale]}
        >
          {localeCode[locale]}
        </a>
      );
    })
  }
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .lang-switch__option {
    padding: 0.35rem 0.6rem;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-muted-strong);
    text-decoration: none;
    transition:
      background-color var(--duration) var(--easing),
      color var(--duration) var(--easing);
  }

  .lang-switch__option + .lang-switch__option {
    border-left: 1px solid var(--color-border-control);
  }

  .lang-switch__option:hover {
    background: var(--color-tint);
    color: var(--color-primary-dark);
  }

  .lang-switch__option--current,
  .lang-switch__option--current:hover {
    background: var(--color-primary);
    color: #ffffff;
  }

  /* The outline would otherwise be clipped by the rounded container. */
  .lang-switch__option:focus-visible {
    outline-offset: -3px;
  }
</style>

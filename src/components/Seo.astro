---
import { htmlLang, localeHref, locales, ui, type Locale } from '../data/i18n';
import { links, site } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Locale-less path of the current page, e.g. "/research/". */
  path: string;
  /** Set on the home page so the title is not suffixed with the lab name. */
  isHome?: boolean;
}

const { title, description, lang, path, isHome = false } = Astro.props;
const t = ui[lang];

const pageTitle = isHome ? site.defaultTitle : site.titleTemplate.replace('%s', title);
const canonical = new URL(withBase(localeHref(lang, path)), Astro.site).href;
const ogImage = new URL(withBase(site.ogImage), Astro.site).href;

/** One alternate per language, plus x-default pointing at English. */
const alternates = locales.map((locale) => ({
  hreflang: htmlLang[locale],
  href: new URL(withBase(localeHref(locale, path)), Astro.site).href,
}));

const homeUrl = new URL(withBase('/'), Astro.site).href;
const peopleUrl = new URL(withBase('/people/'), Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ResearchOrganization',
      '@id': `${homeUrl}#organization`,
      name: site.labName,
      alternateName: site.labFullName,
      description: t.home.metaDescription,
      url: homeUrl,
      email: site.email,
      parentOrganization: {
        '@type': 'CollegeOrUniversity',
        name: site.institution,
      },
      department: {
        '@type': 'Organization',
        name: site.department,
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '30, Pildong-ro 1-gil',
        addressLocality: 'Jung-gu, Seoul',
        postalCode: '04620',
        addressCountry: 'KR',
      },
      member: { '@id': `${peopleUrl}#yerin-hwang` },
    },
    {
      '@type': 'Person',
      '@id': `${peopleUrl}#yerin-hwang`,
      name: site.piName,
      alternateName: site.piNameKo,
      jobTitle: site.piTitle,
      email: site.email,
      url: links.piWebsite,
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: site.institution,
      },
      worksFor: { '@id': `${homeUrl}#organization` },
      sameAs: [links.piWebsite, links.scholar, links.github, links.linkedin, links.openreview],
    },
  ],
};
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(withBase(localeHref('en', path)), Astro.site).href}
/>

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.labFullName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={`${site.labName} — ${site.labExpansion}, ${site.institution}`}
/>
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

---
import { researchAreas } from '../data/research';
import type { Locale } from '../data/i18n';

interface Props {
  lang: Locale;
  headingLevel?: 'h3' | 'h4';
}

const { lang, headingLevel: Heading = 'h3' } = Astro.props;
---

<ul class="research-areas">
  {
    researchAreas.map((area, index) => (
      <li class="research-area" id={area.id}>
        <p class="research-area__number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </p>
        <Heading class="research-area__title">{area.title[lang]}</Heading>
        <p class="research-area__description">{area.description[lang]}</p>
        <ul class="tag-list research-area__keywords">
          {/* Keywords stay in English in both versions. */}
          {area.keywords.map((keyword) => (
            <li class="tag" lang="en">
              {keyword}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<style>
  /* Deliberately 2×2 rather than auto-fit: four areas in a three-column grid
     would leave a conspicuous empty cell. */
  .research-areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-border);
    overflow: hidden;
  }

  .research-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: clamp(1.25rem, 0.9rem + 1.2vw, 2rem);
    background: var(--color-surface);
    scroll-margin-top: calc(var(--header-height) + var(--space-lg));
  }

  /* A quiet index instead of an illustrative icon. */
  .research-area__number {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-accent-deep);
  }

  .research-area__title {
    margin-top: var(--space-2xs);
  }

  .research-area__description {
    font-size: var(--text-sm);
    word-break: keep-all;
    line-height: 1.65;
    color: var(--color-muted-strong);
  }

  .research-area__keywords {
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  @media (max-width: 44rem) {
    .research-areas {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
/**
 * Small inline SVG icon set. Kept deliberately tiny — no icon library.
 *
 * Icons are decorative by default (`aria-hidden`), because every place they
 * appear also carries a visible or screen-reader-only text label.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'mail'
  | 'globe'
  | 'scholar'
  | 'github'
  | 'linkedin'
  | 'openreview'
  | 'document'
  | 'menu';

interface Props {
  name: IconName;
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M4 12h15m0 0-6-6m6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7m0 0H8.5M17 7v8.5" />}
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3.5 6.5 8.5 6 8.5-6" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9S14.4 18.5 12 21c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" />
      </>
    )
  }
  {
    name === 'scholar' && (
      <>
        <path d="M12 4 2.5 9 12 14l9.5-5L12 4Z" />
        <path d="M6.5 11.4V16c0 1.7 2.5 3 5.5 3s5.5-1.3 5.5-3v-4.6" />
      </>
    )
  }
  {
    name === 'github' && (
      <path
        d="M9.2 20.4c-4 1.2-4-2.1-5.6-2.5m11.2 5v-3.4c0-1 .1-1.4-.5-2 2.6-.3 5.1-1.3 5.1-5.6a4.4 4.4 0 0 0-1.2-3 4.1 4.1 0 0 0-.1-3s-1-.3-3.3 1.2a11.3 11.3 0 0 0-5.7 0C6.8 4.6 5.8 4.9 5.8 4.9a4.1 4.1 0 0 0-.1 3 4.4 4.4 0 0 0-1.2 3.1c0 4.2 2.5 5.2 5.1 5.5-.6.6-.6 1.2-.5 2v3.4"
      />
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2.5" />
        <path d="M7.5 10.5V17M7.5 7.2v.1M11.5 17v-3.8a2.2 2.2 0 0 1 4.4 0V17" />
      </>
    )
  }
  {
    name === 'openreview' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5v9M9 10.5h6" />
      </>
    )
  }
  {
    name === 'document' && (
      <>
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
        <path d="M14 3v5h5M9 13h6M9 17h4" />
      </>
    )
  }
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>

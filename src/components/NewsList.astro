---
import Icon from './Icon.astro';
import { defaultLocale, type Locale } from '../data/i18n';
import type { NewsEntry } from '../utils/content';

interface Props {
  news: NewsEntry[];
  headingLevel?: 'h2' | 'h3' | 'h4';
  lang?: Locale;
}

const { news, headingLevel: Heading = 'h3', lang = defaultLocale } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat(lang === 'ko' ? 'ko-KR' : 'en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<ol class="news-list">
  {
    news.map((item) => (
      <li class="news-item">
        <time class="news-item__date" datetime={item.data.date.toISOString().slice(0, 10)}>
          {dateFormatter.format(item.data.date)}
        </time>
        <div class="news-item__body">
          <Heading class="news-item__title">
            {item.data.url ? (
              <a class="news-item__link" href={item.data.url}>
                {item.data.title}
                <Icon name="arrow-up-right" size={14} />
              </a>
            ) : (
              item.data.title
            )}
          </Heading>
          {item.data.summary && <p class="news-item__summary">{item.data.summary}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .news-item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .news-item + .news-item {
    border-top: 1px solid var(--color-border);
  }

  .news-item__date {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    padding-top: 0.1rem;
  }

  .news-item__title {
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .news-item__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--color-text);
    text-decoration: none;
  }

  .news-item__link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .news-item__summary {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted-strong);
  }

  @media (max-width: 36rem) {
    .news-item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }
  }
</style>

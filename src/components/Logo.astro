---
import { site } from '../data/site';
import { defaultLocale, localeHref, type Locale } from '../data/i18n';
import { withBase } from '../utils/paths';

interface Props {
  /** `full` shows the acronym expansion under the wordmark. */
  variant?: 'full' | 'compact';
  /** Rendered as a link to the home page unless false. */
  asLink?: boolean;
  /** Use the light-on-dark palette. */
  onDark?: boolean;
  lang?: Locale;
}

const { variant = 'full', asLink = true, onDark = false, lang = defaultLocale } = Astro.props;
const Tag = asLink ? 'a' : 'div';
// The wordmark and its expansion stay in English in both versions.
const linkProps = asLink
  ? { href: withBase(localeHref(lang, '/')), 'aria-label': site.srLabel }
  : {};
---

<Tag class:list={['logo', { 'logo--on-dark': onDark }]} {...linkProps}>
  {/* Four-point light mark: the only literal nod to the name. */}
  <svg
    class="logo__mark"
    width="22"
    height="22"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M12 1.5c.55 5.2 5.15 9.8 10.35 10.35v.3C17.15 12.7 12.55 17.3 12 22.5h-.3C11.15 17.3 6.55 12.7 1.35 12.15v-.3C6.55 11.3 11.15 6.7 11.7 1.5Z"
      fill="currentColor"
    ></path>
  </svg>
  <span class="logo__text">
    <span class="logo__wordmark">{site.labShortName}</span>
    {
      variant === 'full' && (
        <span class="logo__expansion">{site.labExpansion}</span>
      )
    }
  </span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .logo__mark {
    color: var(--color-accent);
    transition: transform var(--duration) var(--easing);
  }

  a.logo:hover .logo__mark {
    transform: rotate(45deg);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__wordmark {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-primary-dark);
  }

  .logo__expansion {
    margin-top: 0.15rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-muted);
  }

  .logo--on-dark .logo__wordmark {
    color: var(--color-on-dark);
  }

  .logo--on-dark .logo__expansion {
    color: var(--color-on-dark-muted);
  }

  /* On narrow screens the expansion would push the menu button off-screen. */
  @media (max-width: 40rem) {
    .logo__expansion {
      display: none;
    }
  }
</style>

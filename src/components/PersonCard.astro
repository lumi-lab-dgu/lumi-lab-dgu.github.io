---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SocialLinks, { type SocialLink } from './SocialLinks.astro';
import { ui, type Locale } from '../data/i18n';
import type { PersonEntry } from '../utils/content';
import { publicFileExists } from '../utils/assets';
import { withBase } from '../utils/paths';

interface Props {
  person: PersonEntry;
  lang: Locale;
  /** Extra links appended after the profile links, e.g. a CV. */
  extraLinks?: SocialLink[];
  /** `h1` when this profile is the main heading of its page. */
  headingLevel?: 'h1' | 'h2';
}

const { person, lang, extraLinks = [], headingLevel: NameTag = 'h2' } = Astro.props;
const t = ui[lang];

/** Sub-headings sit one level under the name so the outline never skips. */
const SubHeading = NameTag === 'h1' ? 'h2' : 'h3';
const { name, nameKo, interests, photo } = person.data;

// Korean fields fall back to English, so a half-translated entry still renders.
const isKo = lang === 'ko';
const role = (isKo && person.data.roleKo) || person.data.role;
const affiliation = (isKo && person.data.affiliationKo) || person.data.affiliation;
const bioShort = (isKo && person.data.bioShortKo) || person.data.bioShort;
const bioLongKo = isKo ? person.data.bioLongKo : undefined;

/**
 * Portraits are looked up in src/assets/people/ first so astro:assets can
 * optimise them, then in public/people/. When neither exists we render an
 * initials placeholder rather than a broken image.
 */
const assetPortraits = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/people/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const optimisedPortrait = photo ? assetPortraits[`/src/assets/people/${photo}`]?.default : undefined;
const publicPortrait =
  photo && !optimisedPortrait && publicFileExists(`/people/${photo}`)
    ? withBase(`/people/${photo}`)
    : undefined;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');

/** Only the profiles this person actually has get a link. */
const profileLinks: SocialLink[] = [];
const { website, email, scholar, github, linkedin, openreview } = person.data;

if (website) profileLinks.push({ label: 'Website', href: website, icon: 'globe' });
if (email) profileLinks.push({ label: 'Email', href: `mailto:${email}`, icon: 'mail' });
if (scholar) profileLinks.push({ label: 'Google Scholar', href: scholar, icon: 'scholar' });
if (github) profileLinks.push({ label: 'GitHub', href: github, icon: 'github' });
if (linkedin) profileLinks.push({ label: 'LinkedIn', href: linkedin, icon: 'linkedin' });
if (openreview) profileLinks.push({ label: 'OpenReview', href: openreview, icon: 'openreview' });

const allLinks = [...profileLinks, ...extraLinks];
---

<article class="person">
  <div class="person__aside">
    <div class="person__portrait">
      {
        optimisedPortrait ? (
          <Image
            src={optimisedPortrait}
            alt={`${t.people.portraitOf} ${name}`}
            widths={[176, 352]}
            sizes="(max-width: 48rem) 7rem, 11rem"
            loading="eager"
            class="person__photo"
          />
        ) : publicPortrait ? (
          <img
            src={publicPortrait}
            alt={`${t.people.portraitOf} ${name}`}
            width="480"
            height="480"
            loading="eager"
            decoding="async"
            class="person__photo"
          />
        ) : (
          <div class="person__initials" role="img" aria-label={`${name} — ${t.people.portraitPending}`}>
            <span aria-hidden="true">{initials}</span>
          </div>
        )
      }
    </div>
  </div>

  <div class="person__body">
    <header class="person__header">
      <NameTag class="person__name">
        {name}
        {nameKo && <span class="person__name-ko" lang="ko">{nameKo}</span>}
      </NameTag>
      <p class="person__role">{role}</p>
      <p class="person__affiliation">{affiliation}</p>
    </header>

    <p class="person__bio">{bioShort}</p>

    {bioLongKo ? <p class="person__long-bio">{bioLongKo}</p> : <slot />}

    {
      interests.length > 0 && (
        <div class="person__interests">
          <SubHeading class="person__subheading">{t.people.researchInterests}</SubHeading>
          <ul class="tag-list">
            {interests.map((interest) => (
              <li class="tag">{interest}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      allLinks.length > 0 && (
        <div class="person__links">
          <SubHeading class="person__subheading">{t.people.links}</SubHeading>
          <SocialLinks links={allLinks} label={`${t.people.links} — ${name}`} />
        </div>
      )
    }
  </div>
</article>

<style>
  .person {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 0.9rem + 2.4vw, 3rem);
    align-items: start;
  }

  .person__aside {
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
  }

  .person__portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .person__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person__initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(150deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.4rem + 4vw, 4rem);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .person__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: clamp(1.5rem, 1.3rem + 0.9vw, 2rem);
  }

  .person__name-ko {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .person__role {
    margin-top: var(--space-2xs);
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .person__affiliation {
    margin-top: 0.1rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .person__bio {
    margin-top: var(--space-lg);
    max-width: 68ch;
    word-break: keep-all;
  }

  .person__body :global(p) {
    word-break: keep-all;
  }

  .person__body :global(.person__long-bio) {
    margin-top: var(--space-md);
    max-width: 68ch;
  }

  .person__interests,
  .person__links {
    margin-top: var(--space-lg);
  }

  .person__subheading {
    margin-bottom: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 48rem) {
    .person {
      grid-template-columns: minmax(0, 1fr);
    }

    .person__aside {
      position: static;
    }

    .person__portrait {
      width: 7rem;
    }
  }
</style>

# Copy to `.env` only if you need to build locally for a specific deployment
# target. GitHub Actions sets both values automatically from the repository's
# Pages configuration, so you normally do not need this file at all.

# Absolute origin the site is served from (no trailing path).
#   user / organization Pages : https://lumi-lab-dgu.github.io
#   project Pages             : https://lumi-lab-dgu.github.io
PUBLIC_SITE_URL=https://lumi-lab-dgu.github.io

# Sub-path the site is served from.
#   repo named <owner>.github.io : /
#   repo named <repo-name>       : /<repo-name>
PUBLIC_BASE_PATH=/
